    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit ratio (app)",
      "description": "hit + negative_hit + wait_hit out of all lookups that used the cache",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-lab3"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-lab3"
          },
          "expr": "sum(rate(app_cache_requests_total{result=~\"hit|negative_hit|wait_hit\"}[1m])) / sum(rate(app_cache_requests_total{result!=\"bypass\"}[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
