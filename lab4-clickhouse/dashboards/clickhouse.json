    {
      "type": "timeseries",
      "title": "Part events per minute",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-lab4"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-lab4"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(event_time) AS time, toString(event_type) AS event, count() * 60 / $__interval_s AS per_minute\nFROM system.part_log WHERE $__timeFilter(event_time) AND database = 'lab4' AND event_type IN ('NewPart', 'MergeParts', 'RemovePart')\nGROUP BY time, event\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.labels.event}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m",
      "description": "NewPart = one insert block, MergeParts = background merge, RemovePart = inactive part deleted.",
