          "queryType": "table",
          "rawSql": "SELECT table, sum(rows) AS rows, count() AS active_parts, uniqExact(partition) AS partitions, max(level) AS max_level,\n       sum(data_compressed_bytes) AS compressed, sum(data_uncompressed_bytes) AS uncompressed,\n       round(sum(data_uncompressed_bytes) / greatest(1, sum(data_compressed_bytes)), 1) AS ratio\nFROM system.parts WHERE active AND database = 'lab4'\nGROUP BY table\nORDER BY table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
