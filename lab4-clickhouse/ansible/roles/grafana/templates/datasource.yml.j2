apiVersion: 1

datasources:
  - name: ClickHouse Lab 4
    uid: {{ grafana_datasource_uid }}
    type: {{ grafana_clickhouse_plugin }}
    editable: false
    jsonData:
      host: 127.0.0.1
      port: {{ clickhouse_tcp_port }}
      protocol: native
      secure: false
      username: {{ clickhouse_accounts.grafana.name }}
      defaultDatabase: {{ clickhouse_database }}
    secureJsonData:
      password: {{ clickhouse_accounts.grafana.password | to_json }}
