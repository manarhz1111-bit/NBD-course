# Managed by Ansible (lab2)
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: "opensearch"
    scheme: https
    metrics_path: /_prometheus/metrics
    basic_auth:
      username: "{{ monitor_user }}"
      password_file: /etc/prometheus/opensearch_monitor.pass
    tls_config:
      ca_file: /etc/prometheus/certs/root-ca.pem
    static_configs:
{% for node in opensearch_nodes %}
      - targets: ["{{ opensearch_api_host }}:{{ node.http_port }}"]
        labels:
          node_name: "{{ node.name }}"
          temp: "{{ node.temp }}"
{% endfor %}

  - job_name: "prometheus"
    static_configs:
      - targets: ["127.0.0.1:{{ prometheus_port }}"]
