groups:
  - name: lab5-recording
    rules:
      - record: lab5:search_requests:rate1m
        expr: sum by (mode) (rate(lab5_search_requests_total[1m]))
      - record: lab5:search_latency_seconds:p95
        expr: histogram_quantile(0.95, sum by (le, stage) (rate(lab5_search_duration_seconds_bucket[1m])))
      - record: lab5:search_errors:ratio1m
        expr: sum(rate(lab5_search_requests_total{status="error"}[1m])) / clamp_min(sum(rate(lab5_search_requests_total[1m])), 1e-9)
      - record: lab5:qdrant_query_latency_seconds:p95
        expr: histogram_quantile(0.95, sum by (le) (rate(rest_responses_duration_seconds_bucket{endpoint=~".*/points/query"}[1m])))

  - name: lab5-alerts
    rules:
      - alert: QdrantDown
        expr: up{job="qdrant"} == 0
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: Qdrant does not answer the metrics scrape

      - alert: SearchApiDown
        expr: up{job="product-search"} == 0
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: The product search API does not answer

      - alert: SearchLatencyHigh
        expr: lab5:search_latency_seconds:p95{stage="total"} > 0.25
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "p95 search latency is {{ '{{' }} $value | humanizeDuration {{ '}}' }}"

      - alert: SearchErrors
        expr: lab5:search_errors:ratio1m > 0.01
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: More than 1% of searches fail

      - alert: CollectionEmpty
        expr: collection_points{id="{{ qdrant_collection }}"} == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: The product collection has no points
